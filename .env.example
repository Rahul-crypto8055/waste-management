# ─────────────────────────────────────────────────────────────
# Smart Recycling Assistant — environment configuration
# Copy this file to `.env` for local use, OR set these in Vercel:
#   Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Google Gemini API key (powers the GenAI Circular Advisor).
# Get a free key at: https://aistudio.google.com/apikey
# If this is blank, the advisor automatically falls back to the built-in
# rule-based engine, so the app still works with no key / offline.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
